    "faq": {
      "brand": [
        { "q": "How do I create a campaign?", "a": "Navigate to Campaigns in the sidebar and click 'New Campaign' to get started." },
        { "q": "How do I invite creators?", "a": "Open a campaign, go to the Gigs tab, and use the invite action to send invitations to creators." },
        { "q": "How does billing work?", "a": "You are billed per campaign based on your selected plan. Visit Settings > Billing for details." },
        { "q": "How do I review submissions?", "a": "Open a gig from your campaign and navigate to the Submissions tab to review creator content." },
        { "q": "Can I run multiple campaigns?", "a": "Yes, you can create and manage multiple campaigns simultaneously from the Campaigns section." }
      ],
      "creator": [
        { "q": "How do I join a campaign?", "a": "Browse available gigs in the Gigs section and click Apply to submit your application." },
        { "q": "When will I get paid?", "a": "Payouts are processed within 14 days of your content being approved by the brand." },
        { "q": "How do I submit content?", "a": "Open your active gig from the Gigs section and click Submit to upload your video." },
        { "q": "What happens after I submit?", "a": "The brand will review your submission and either approve, return, or reject it with feedback." },
        { "q": "How do I update my profile?", "a": "Go to My Profile in the sidebar to update your bio, categories, and social media links." }
      ],
      "admin": [
        { "q": "How do I manage users?", "a": "Navigate to Users in the main navigation to view, edit, or deactivate accounts." },
        { "q": "How do I review brand profiles?", "a": "Go to Brands, open a brand profile, and use the action menu to update their status." },
        { "q": "How do I assign a support case?", "a": "Open a case from the Cases page and use the action menu to assign it to an admin." },
        { "q": "How do I approve a campaign?", "a": "Go to Campaigns, open the campaign, and use the action menu to accept or reject it." },
        { "q": "How do I send platform notifications?", "a": "Navigate to Notifications and use the Create Notification button to send targeted messages." }
      ]
    },
